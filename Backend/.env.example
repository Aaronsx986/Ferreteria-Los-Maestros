# Copia este archivo como .env y cambia los valores. El .env NO se sube a git.
DB_PASSWORD=cambia-esta-clave

# Clave compartida productos <-> ventas para llamadas internas (/internal/**). Usa 32+ caracteres al azar.
INTERNAL_API_KEY=cambia-esta-clave-interna-larga

# Opcionales: si no se definen, docker-compose.yml usa estos valores por defecto.
# AUTH_JWKS_URL=http://usuarios:8082/api/auth/jwks
# JWT_ISSUER=losmaestros-usuarios

# Orígenes del frontend permitidos por CORS en el gateway (separados por coma).
# En AWS agrega la URL del sitio web del bucket, por ejemplo:
# FRONTEND_ORIGINS=http://localhost:*,http://mi-bucket.s3-website-us-east-1.amazonaws.com
